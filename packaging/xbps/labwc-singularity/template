# Template file for 'labwc-singularity'
pkgname=labwc-singularity
version=0.20.2
revision=1
# Pinned to the commit recorded in the singularity-desktop submodule. Bump it
# together with the submodule so the fork and the desktop stay in sync.
_commit="458dddc5c78cf211a1a9f43baa16d221ed96a223"
build_style=meson
configure_args="--prefix=/usr --libdir=lib --buildtype=release
 -Dxwayland=enabled --force-fallback-for=wlroots-0.20"
hostmakedepends="meson ninja pkg-config gettext scdoc wayland-devel wayland-protocols git"
makedepends="cairo-devel glib-devel libpng-devel librsvg-devel libsfdo-devel
 libxml2-devel pango-devel wlroots0.20-devel xorg-server-xwayland
 libdisplay-info-devel libliftoff-devel libdrm-devel libinput-devel
 libseat-devel libxkbcommon-devel eudev-libudev-devel"
# The desktop launches this fork; it must replace the stock package.
conflicts="labwc>=0"
provides="labwc-${version}_${revision}"
short_desc="Singularity fork of the labwc Wayland compositor"
maintainer="Dicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/singularityos-lab/singularity-desktop"
repository="https://github.com/singularityos-lab/labwc.git"

do_fetch() {
	msg_normal "Cloning ${repository} (${_commit}) with submodules...\n"
	git clone --recurse-submodules "${repository}" "${pkgname}-${version}"
	(cd "${pkgname}-${version}" && git checkout "${_commit}" \
		&& git submodule update --init --recursive)
}
