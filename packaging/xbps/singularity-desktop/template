# Template file for 'singularity-desktop'
pkgname=singularity-desktop
version=0.1.0
revision=1
# Pinned to the master commit this template was checked against. Bump it when
# re-verifying the build (the upstream repo has no release tags yet).
_commit="6427e9c4754325c99c98bfda2060008156b8e1de"
# glibc x86_64 only: the gesture runtime blobs are glibc x86_64. A musl build
# needs -Dgestures=disabled (supported) and has not been tested yet.
archs="x86_64"
build_style=meson
configure_args="--prefix=/usr -Dlibdir=lib -Dinstaller=false"
hostmakedepends="meson ninja vala pkg-config gettext glib-devel
 gobject-introspection sassc scdoc wayland-protocols git python3 curl unzip go bash"
makedepends="gtk4-devel gtk4-layer-shell-devel vte3-gtk4-devel
 gtksourceview5-devel libpeas2-devel libgee-devel NetworkManager-devel
 upower-devel pulseaudio-devel gnome-online-accounts-devel polkit-devel
 libsoup3-devel json-glib-devel libdbusmenu-glib-devel at-spi2-core-devel
 tinysparql-devel eudev-libudev-devel libgudev-devel pam-devel elogind-devel
 wayland-devel libxkbcommon-devel cairo-devel pango-devel gdk-pixbuf-devel
 libxcb-devel libpng-devel librsvg-devel libsfdo-devel libxml2-devel
 libsecret-devel poppler-glib-devel gst-plugins-base1-devel
 gst1-editing-services-devel pipewire-devel libdisplay-info-devel
 libliftoff-devel libdrm-devel MesaLib-devel libglvnd-devel libgbm-devel
 libinput-devel libseat-devel xorg-server-xwayland xorgproto xcb-proto
 libX11-devel libXcursor-devel libXdamage-devel libXext-devel libXfixes-devel
 libXi-devel libXinerama-devel libXrandr-devel libXrender-devel
 libXcomposite-devel libXres-devel libXxf86vm-devel libXtst-devel
 libXScrnSaver-devel xcb-util-devel xcb-util-wm-devel xcb-util-errors-devel
 xcb-util-image-devel xcb-util-keysyms-devel xcb-util-renderutil-devel
 xcb-util-cursor-devel libusb-devel cmocka-devel libxcrypt-devel cups-devel
 colord-devel libarchive-devel libjpeg-turbo-devel tiff-devel libwebp-devel
 vulkan-loader-devel Vulkan-Headers shaderc libevdev-devel libfido2-devel
 libwacom-devel libsodium-devel libzbar-devel libgcrypt-devel nettle-devel
 freerdp3-devel sane-devel SDL2-devel fuse3-devel liblzma-devel mtdev-devel
 sqlite-devel libzstd-devel zlib-devel gnutls-devel glu-devel
 libwebkitgtk60-devel hwids iso-codes enchant2-devel libgphoto2-devel"
depends="dbus elogind greetd xdg-desktop-portal xdg-user-dirs
 hicolor-icon-theme desktop-file-utils gtk4-layer-shell libpeas2 tinysparql
 vte3-gtk4 gtksourceview5 python3 libdecor"
short_desc="Singularity Desktop Environment (Wayland, GTK4)"
maintainer="Dicov <SrDicov@gmail.com>"
license="GPL-3.0-only"
homepage="https://github.com/singularityos-lab/singularity-desktop"
repository="https://github.com/singularityos-lab/singularity-desktop.git"

do_fetch() {
	msg_normal "Cloning ${repository} (${_commit}) with submodules...\n"
	git clone --recurse-submodules "${repository}" "${pkgname}-${version}"
	(cd "${pkgname}-${version}" && git checkout "${_commit}" \
		&& git submodule update --init --recursive)
}

post_fetch() {
	# Gesture runtime blobs (glibc x86_64) must exist before meson setup.
	msg_normal "Bootstrapping gesture runtime...\n"
	(cd "${pkgname}-${version}" \
		&& PYTHON=python3 bash subprojects/singularity-gestures/scripts/bootstrap-runtime.sh)
}

do_build() {
	meson setup build --prefix=/usr --libdir=lib \
		--buildtype=release -Dinstaller=false
	meson compile -C build
}

do_install() {
	DESTDIR="${DESTDIR}" meson install -C build
	glib-compile-schemas "${DESTDIR}"/usr/share/glib-2.0/schemas
	# Host-integration scripts referenced by the INSTALL message.
	vinstall scripts/deploy-to-host.sh 755 usr/share/doc/singularity-desktop
	vinstall scripts/install-greeter.sh 755 usr/share/doc/singularity-desktop
}
